# ─── Bheda env template ───
# Copy to .env, then run: ./scripts/generate-secrets.sh
# All CHANGE_ME values MUST be replaced before any deployment.

# ─── Database ───
POSTGRES_USER=bheda
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=bheda
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0
MONGO_USER=bheda
MONGO_PASSWORD=CHANGE_ME_mongo_password
MONGO_URL=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@localhost:27017/bheda

# ─── Auth ───
SECRET_KEY=CHANGE_ME_jwt_signing_key_min_32_chars
API_KEY=CHANGE_ME_internal_api_key_for_services

# ─── CTF flag secret (used by vuln-app) ───
FLAG_SECRET=CHANGE_ME_flag_secret_min_32_chars

# ─── Mode ───
MODE=practice  # or 'ctf'
RABBIT_HOLES_ENABLED=true
SCHEDULER_ENABLED=true
PROFILES_ENABLED=true

# ─── CTF ───
CTF_MAX_TEAM_SIZE=5
CTF_DEFAULT_EVENT_DURATION_HOURS=48

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── WAF ───
WAF_ENABLED=true
WAF_MODE=anomaly  # anomaly or blocking

# ─── TLS Lab ───
TLS_LAB_ENABLED=true

# ─── Logging ───
LOG_LEVEL=INFO
