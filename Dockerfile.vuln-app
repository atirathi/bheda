FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    php-cli \
    default-jre \
    mono-complete \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY vuln-app/package.json vuln-app/tsconfig.json ./
RUN npm install

COPY vuln-app/src ./src
RUN npm run build

EXPOSE 3000

ENV NODE_ENV=development
ENV PG_HOST=localhost
ENV PG_PORT=5432
ENV PG_DB=bheda
ENV PG_USER=bheda
ENV PG_PASS=bheda_secret
ENV MONGO_URI=mongodb://localhost:27017/bheda
ENV REDIS_URL=redis://localhost:6379
ENV BACKEND_URL=http://localhost:4000
ENV FLAG_SECRET=bheda_lab_secret_key_2024

CMD ["node", "dist/app.js"]
