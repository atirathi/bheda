FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY vuln-app/package.json vuln-app/tsconfig.json ./
RUN npm install --omit=dev && npm cache clean --force

COPY vuln-app/src ./src
RUN npm run build

EXPOSE 3000

ENV NODE_ENV=production
ENV PG_HOST=postgres
ENV PG_PORT=5432
ENV PG_DB=bheda
ENV PG_USER=bheda
ENV PG_PASS=""
ENV MONGO_URI=mongodb://mongo:27017/bheda
ENV REDIS_URL=redis://redis:6379
ENV BACKEND_URL=http://backend:8000

# Secrets MUST be provided at runtime (docker-compose, k8s, or runtime env).
# Never bake FLAG_SECRET or any credential into the image.

CMD ["node", "dist/app.js"]
