# ─── Database ───
DATABASE_URL=postgresql+asyncpg://bheda:bheda_secret_2026@localhost:5432/bheda
REDIS_URL=redis://:bheda_redis_2026@localhost:6379/0
MONGO_URL=mongodb://bheda:bheda_mongo_2026@localhost:27017/bheda

# ─── Auth ───
SECRET_KEY=bheda-jwt-secret-key-2026-super-secure
API_KEY=

# ─── Mode ───
MODE=practice  # or 'ctf'
RABBIT_HOLES_ENABLED=true
SCHEDULER_ENABLED=true
PROFILES_ENABLED=true

# ─── CTF ───
CTF_MAX_TEAM_SIZE=5
CTF_DEFAULT_EVENT_DURATION_HOURS=48

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── WAF ───
WAF_ENABLED=true
WAF_MODE=anomaly  # anomaly or blocking

# ─── TLS Lab ───
TLS_LAB_ENABLED=true

# ─── Logging ───
LOG_LEVEL=INFO
