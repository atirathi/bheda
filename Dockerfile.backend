FROM python:3.12-slim

# Create a non-root user for runtime. Don't pin uid/gid 1000 — keep this
# robust against base images that already reserve it.
RUN groupadd -r bheda && useradd -r -g bheda -m -d /app bheda

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    apt-get purge -y --auto-remove gcc libpq-dev

COPY --chown=bheda:bheda backend/src /app/src

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

USER bheda

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
